# arena/rag-pipeline claim — ignore rules for the new wings only.
# (Repo previously had no .gitignore; nothing existing is affected.)

# Full-run RAG database (rebuilt locally; only rag/vectordb_sample/ is committed)
rag/vectordb/
rag/text_cache/

# YouTube wing: downloaded media + secrets + run state (see youtube-archive/README.md)
youtube-archive/videos/
youtube-archive/documents/
youtube-archive/client_secrets.json

# Streamlit local secrets -- the arrest page's access password lives here.
# Never commit it: this repository is public.
.streamlit/secrets.toml
.streamlit/secrets/*.toml
secrets.toml

youtube-archive/yt_token.json
youtube-archive/upload_state.json
youtube-archive/*.part

# Python noise
__pycache__/
*.pyc
.venv/


# raw PDFs are on branch archive/raw-pdfs (Streamlit Cloud 1 GB clone limit)
2026-09-14-council/civicwatch/data/raw/**
!2026-09-14-council/civicwatch/data/raw/README.md

# ai-record claim — generated AI-readable mirror (rebuilt + deployed by .github/workflows/ai-record-pages.yml)
/ai-record/
/_site/
# Google Drive connector download scratch dir
/google_drive/

# SEALED arrest name key — de-identified public tier is committed, names are not.
# See data/arrests/README.md. Released only via .github/ISSUE_TEMPLATE/arrest-name-request.md
/data/arrests/name_key.json
/data/arrests/name_key.json.*

# SQLite WAL/SHM sidecars — transient, recreated on open. Committing a stale
# -wal next to engine.db can make SQLite replay it over the committed state.
*.db-shm
*.db-wal
*.db-journal
/data/arrests/keyring.jsonl
/data/arrests/access_ledger.json

.sudo_as_admin_successful

data/selftest/
