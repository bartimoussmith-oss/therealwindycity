 .github/workflows/deploy-pages.yml     | 17 +++++++++++++++++
 src/app/explore/public-safety/page.tsx |  2 +-
 src/app/page.tsx                       |  4 ++--
 src/components/site-help.tsx           |  2 +-
 4 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/deploy-pages.yml b/.github/workflows/deploy-pages.yml
index 293d6be..16dfb0e 100644
--- a/.github/workflows/deploy-pages.yml
+++ b/.github/workflows/deploy-pages.yml
@@ -28,6 +28,23 @@ jobs:
           node-version: 22
           cache: npm
       - run: npm ci
+      # Fail fast on lint before anything is published.
+      #
+      # `next build` only lints Next's default eslint dirs (app, pages,
+      # components). With no `eslint.eslintDirs` override in next.config.ts, a
+      # react/no-unescaped-entities violation under src/app/ does NOT fail the
+      # build, so Pages publishes it and only the separate CI workflow goes red.
+      # That is exactly what happened: CI lint failed on src/app/page.tsx and
+      # src/app/explore/public-safety/page.tsx from 2026-10-22T00:48Z onward
+      # while Pages kept deploying, and Pages itself only broke once the same
+      # class of violation landed in src/components/site-help.tsx (678193d3).
+      #
+      # This workflow runs hourly on cron and on every push to main, so an
+      # unlinted commit would otherwise be republished every hour with nobody
+      # watching. The eslint invocation below is `eslint .`, covering the whole
+      # repository rather than only the directories Next happens to lint.
+      - name: Lint gate (whole repo, not just Next's build-time lint dirs)
+        run: npm run lint
       - name: Restore scanner-archive linkage cache
         uses: actions/cache@v4
         with:
