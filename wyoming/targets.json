{
  "manifest_version": 1,
  "as_of": "2026-11-07",
  "title": "Wyoming Statewide Passive OSINT & Public-Records Infrastructure Target Matrix",
  "policy": {
    "collection_mode": "passive_metadata_and_polite_vendor_fingerprinting_only",
    "allowed_spiderfoot_modules": [
      "sfp_crt",
      "sfp_dnsresolve",
      "sfp_whois",
      "sfp_webframework",
      "sfp_wappalyzer",
      "sfp_email",
      "sfp_accounts"
    ],
    "blocked_active_modules_examples": [
      "sfp_portscan_tcp",
      "sfp_portscan_udp",
      "sfp_nmap",
      "sfp_nuclei",
      "sfp_vuln",
      "sfp_sql",
      "sfp_xss",
      "sfp_brute"
    ],
    "privacy_gate": "LEGAL.md §5 enforced: personal individual email addresses and personal accounts are stripped; only generic institutional/custodian role addresses (clerk@, records@, assessor@, treasurer@, gis@, info@, publicrecords@) and mail-gateway MX hosts (e.g., Mimecast) are retained.",
    "honesty_note": "Domains not listed in reviewed_official_urls are unverified candidates (verification='candidate_unverified'). Passive DNS/CT discovery or HTTP 200 reachability is not proof of official government ownership; verify before filing records requests."
  },
