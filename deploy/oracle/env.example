# /etc/windycity/windycity.env — configuration for the OCI deployment.
# bootstrap.sh writes this file if it is missing, then reads it on every run.
# It lives OUTSIDE the repo: no credentials or hostnames in version control.

# service account and repo location
WINDYCITY_USER=windycity
WINDYCITY_REPO=/opt/windycity
WINDYCITY_REMOTE=https://github.com/bartimoussmith-oss/therealwindycity.git
WINDYCITY_BRANCH=main

# loopback ports the services bind to (nginx proxies to these)
CONSOLE_PORT=8501
PIPELINE_PORT=8717

# public names. DOMAIN empty => console is reachable by IP over plain HTTP.
DOMAIN=
PIPELINE_DOMAIN=

# port nginx exposes the pipeline studio on for bare-IP use (0 disables the block)
STUDIO_PORT=8080

# Let's Encrypt account email (needed for --domain / --pipeline-domain TLS)
LE_EMAIL=

# swap file in MiB — set 0 to skip (2 GB is created automatically on 1 GB shapes)
SWAP_MB=0
